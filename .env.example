# RailRadar API key from https://railradar.in/developers
RAILRADAR_API_KEY=rr_live_your_key_here

# Comma-separated list of train numbers to track, e.g. 12301,12951,22691
TRAIN_NUMBERS=12301,12951

# Path to the SQLite database file (relative to project root)
DB_PATH=data/trains.db

# Base URL for RailRadar API (rarely needs changing)
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# --- Supabase (optional) ---------------------------------------------------
# Leave BOTH blank for local runs: storage falls back to the SQLite file above.
# When both are set, the poller writes to Supabase instead (see app/store.py).
# The service key bypasses row-level security -- it belongs in GitHub Actions
# secrets, never in docs/index.html, which uses the public anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
